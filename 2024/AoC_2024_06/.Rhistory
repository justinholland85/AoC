x.Rules      <-  rbind(x.Rules[-which(x.Rules[,1] %in% i.ID), ])
r.ID         <-  setdiff(r.ID, i.ID)
if(length(r.ID) == 0){break}
}
Order  <-  unlsit(Order)
return(Order)
}
