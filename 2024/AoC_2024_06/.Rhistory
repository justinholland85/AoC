F.Part.1    <-  function(Map){
Nx         <-  ncol(Map)
Ny         <-  nrow(Map)
Coords     <-  Lib.Grid.Coords(Nx - 1, Ny - 1, 1, Nx, 1, Ny)
Coords$Y   <-  rev(Coords$Y)
Grid       <-  Lib.Gridify(Coords)
Grid.X     <-  Grid$Mat.X
Grid.Y     <-  Grid$Mat.Y
Visit      <-  0 * Map
Pos.X      <-  Grid.X[which(Map==2)]
Pos.Y      <-  Grid.Y[which(Map==2)]
Visit[Pos.Y, Pos.X]  <-  1
Dir.N      <-  1
Dir.X      <-  0
Dir.Y      <-  -1
i          <-  1
repeat{
Check.X    <-  Pos.X + Dir.X
Check.Y    <-  Pos.Y + Dir.Y
Exit       <-  Check.X < 1 | Check.X > Nx | Check.Y < 1 | Check.Y > Ny
if(Exit){break}
Blocked   <-  Map[Check.Y, Check.X] == 1
if(Blocked){
Rotate    <-  F.Rotate(Dir.N)
Dir.N     <-   Rotate$Dir.N
Dir.X     <-   Rotate$Dir.X
Dir.Y     <-   Rotate$Dir.Y
} else {
i         <-  i + 1
Pos.X     <-  Check.X
Pos.Y     <-  Check.Y
Visit[Check.Y, Check.X]  <-  i
}
}
Output    <-  list("Count" = sum(Visit > 0),
"Visit" = Visit)
return(Output)
}
