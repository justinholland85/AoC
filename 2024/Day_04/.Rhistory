F.Grid            <-  function(Data){
N.X             <-  ncol(Data)
N.Y             <-  nrow(Data)
Grid            <-  Lib.Gridify(X = seq(1,N.X), Y = seq(1, N.Y))
DF              <-  data.frame("Letter" = c(Data),
"X"      = c(Grid$Mat.X),
"Y"      = c(Grid$Mat.Y)  )
return(DF)
}
