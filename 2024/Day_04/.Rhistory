F.Part.1  <-  funciton(Data){
F.Part.1  <-  function(Data){
Grid.DF     <-  F.Grid(Data)
Base        <-  Grid.DF[which(Grid.DF$Letter == "X"), ]
List        <-  list()
for(i in 1:nrow(Base)){
List[[i]]   <-  F.Word.AllDirs(Base$X[[i]],
Base$Y[[i]],
N,
Grid.DF)
print(i)
}
List  <-  do.call(c, List)
Words   <-  unlist(lapply(List, paste, collapse =""))
return(sum(Words == "XMAS"))
}
