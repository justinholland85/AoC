F.Word.AllDirs    <-  function(X, Y, N, Grid.DF){
Directions    <-  expand.grid(dX = c(-1,0,1),
dY = c(-1, 0 ,1))
Words         <-  list()
for(i in 1:nrow(Directions)){
Words[[i]]   <-  F.Word.Dir(X, Y, Directions$dX[[i]], Directions$dY[[i]], 4, Grid.DF)$Word
}
return(Words)
}
N
