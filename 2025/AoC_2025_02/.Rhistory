names(Pairs)  <-  c("From", "To")
Pairs$Delta   <-  Pairs$To - Pairs$From
Seq           <-  mapply(seq, as.list(Pairs$From), as.list(Pairs$To), SIMPLIFY = FALSE)
Numbers.0     <-  unlist(Seq)
#----- Quick Filters
# --  each digit must appear more than once
